{
  "name": "interactive-drawer",
  "version": "0.4.0",
  "type": "module",
  "description": "Interactive Excalidraw MCP server with built-in viewer",
  "license": "MIT",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "interactive-drawer": "dist/index.js"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:server": "node scripts/build.mjs",
    "dev": "concurrently 'npm run watch' 'npm run serve'",
    "watch": "vite build --watch",
    "serve": "node --watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@modelcontextprotocol/ext-apps": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsdom": "^28.0.0",
    "mcp-handler": "1.0.7",
    "morphdom": "^2.7.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@upstash/redis": "^1.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.0",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "dompurify": ">=3.3.2",
    "nanoid": ">=3.3.8",
    "mermaid": ">=10.9.4",
    "@modelcontextprotocol/sdk": "^1.27.1"
  }
}
